<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\vortex_net8\assets\icons\vortex_logo.ico</ApplicationIcon>
    <AssemblyName>VORTEX_Setup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\vortex_net8\publish\VortexNet8.exe" Link="Payload\VORTEX.exe" />
    <EmbeddedResource Include="..\vortex_net8\assets\icons\vortex_logo.ico" Link="Payload\vortex_logo.ico" />
    <EmbeddedResource Include="..\vortex_net8\assets\icons\vortex_logo.png" Link="Payload\vortex_logo.png" />
  </ItemGroup>

</Project>
