<Window x:Class="VortexSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка VORTEX — Мастер развертывания"
        Height="570" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#080C14"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style x:Key="CyberButtonPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberButtonSecondary" TargetType="Button">
            <Setter Property="Background" Value="#141D2C"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E2E48"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2B40"/>
                    <Setter Property="Foreground" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D131F"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1C273A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА МАСТЕРА -->
        <Border Grid.Row="0" Background="#0C1320" BorderBrush="#1C2C45" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#182844" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Установка VORTEX" FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="Мастер быстрой установки VORTEX Performance Engine" FontSize="10" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
        <Grid Grid.Row="1" Margin="20,16">
            
            <!-- ПАНЕЛЬ 1: КОНФИГУРАЦИЯ УСТАНОВКИ -->
            <StackPanel x:Name="ConfigPanel" Visibility="Visible">
                <!-- Баннер -->
                <Border Background="#0D1524" BorderBrush="#1C2C45" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡️" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Развёртывание единого Windows-приложения" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                            <TextBlock Text="Установка автономного исполняемого файла с интеграцией в ядро Windows, автозапуском и таймером 0.5 мс." FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Выбор каталога -->
                <TextBlock Text="Каталог установки:" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Style="{StaticResource CyberTextBox}" Height="38" Text="C:\Program Files\VORTEX" Margin="0,0,8,0" FontFamily="Consolas"/>
                    <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource CyberButtonSecondary}" Height="38" Click="BrowseFolder_Click"/>
                </Grid>

                <!-- Опции установки -->
                <TextBlock Text="Параметры интеграции в систему:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                <Border Background="#090D15" BorderBrush="#192436" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <StackPanel>
                        <CheckBox x:Name="DesktopShortcutCheck" Content="Создать ярлык на Рабочем столе" IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,4"/>
                        <CheckBox x:Name="StartMenuCheck" Content="Добавить ярлык в главное меню «Пуск»" IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,6"/>
                        <CheckBox x:Name="AutostartCheck" Content="Запускать VORTEX вместе с Windows (Планировщик задач)" IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,6"/>
                        <CheckBox x:Name="LaunchAfterCheck" Content="Запустить VORTEX сразу после завершения установки" IsChecked="True" Foreground="#F8FAFC" FontSize="12" Margin="0,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ПАНЕЛЬ 2: ПРОГРЕСС УСТАНОВКИ -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Background="#0D1524" BorderBrush="#1C2C45" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="ProgressStepText" Text="Подготовка к установке..." FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <ProgressBar x:Name="InstallProgressBar" Height="8" Background="#182234" Foreground="#2563EB" Value="0" Margin="0,0,0,14"/>

                        <Border Background="#080D15" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <TextBox x:Name="InstallLogBox" Height="100" Style="{StaticResource CyberTextBox}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock x:Name="CompleteStatusText" Text="Идет установка компонентов..." FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ -->
        <Border Grid.Row="2" Background="#0C1320" BorderBrush="#1C2C45" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Button x:Name="CancelBtn" Content="Отмена" Style="{StaticResource CyberButtonSecondary}" Width="100" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Cancel_Click"/>
                <Button x:Name="ActionBtn" Content="⚡ УСТАНОВИТЬ VORTEX" Style="{StaticResource CyberButtonPrimary}" Height="38" Padding="20,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Action_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
