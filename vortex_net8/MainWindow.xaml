                                                    <TextBlock Text="Фиксация 100%" FontSize="9" Foreground="#7DD3FC"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- БЕНЧМАРК ИГРОВЫХ DNS В РЕАЛЬНОМ ВРЕМЕНИ (КАК В ВЕРСИИ НА PYTHON) -->
                                        <Border Background="#0B1220" BorderBrush="#1D2E49" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,8,0,0">
