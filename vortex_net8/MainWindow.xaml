                                            <Path x:Name="CircleProgressArc" Stroke="#38BDF8" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathFigure x:Name="CircleArcFigure" StartPoint="115,15">
                                                            <ArcSegment x:Name="CircleArcSegment" Point="115,15" Size="100,100" IsLargeArc="False" SweepDirection="Clockwise"/>
                                                        </PathFigure>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>

