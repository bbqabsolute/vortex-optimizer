                                <TextBlock Text="⚡ ТУРБО-ОТКЛИК КЛАВИАТУРЫ FILTERKEYS (150 МС MONGRAAL / BUGHA)" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                                <TextBlock Text="Снижает задержку повтора с 1000 мс до 150 мс для моментального срабатывания турбо-строительства и трипл-эдитов." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <Border Background="#0D1420" BorderBrush="#1C273A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Тест скорости зажатия клавиши (зажмите любую букву здесь):" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                        <TextBox x:Name="KeyTestBox" Style="{StaticResource CyberTextBox}" Height="42" FontSize="14" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⚡ Mongraal (150 мс / 15 мс)" Style="{StaticResource CyberButtonPrimary}" Height="40" Margin="0,0,10,0" Click="ApplyFkMongraal_Click"/>
                                    <Button Content="⚡ Bugha (130 мс / 20 мс)" Style="{StaticResource CyberButtonSecondary}" Height="40" Margin="0,0,10,0" Click="ApplyFkBugha_Click"/>
                                    <Button Content="🔄 Сброс на стандарт Windows (1000 мс)" Style="{StaticResource CyberButtonSecondary}" Height="40" Click="ResetFkDefault_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================== -->
                <!-- 7. ВКЛАДКА: ТВRollИКИ WINDOWS & FPS (TWEAKS) -->
                <!-- ========================================================== -->
                <ScrollViewer x:Name="ViewTweaks" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="🛠️ ТВRollИКИ СИСТЕМЫ, CPU, GPU И ПАМЯТИ" FontSize="18" FontWeight="Black" Foreground="#F8FAFC"/>
                            <Button Content="Включить все рекомендованные" Style="{StaticResource CyberButtonPrimary}" HorizontalAlignment="Right" Height="36" Click="EnableAllTweaks_Click"/>
                        </Grid>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚡ ПРОЦЕССОР И ВИДЕОКАРТА" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Разпарковка всех ядер CPU (100% активны)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Отключает сон ядер и убирает энергосберегающие задержки" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkCpuUnparkCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#182333" Margin="0,6"/>

                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Высокий приоритет процесса игры" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Автоматически выдаёт максимальный приоритет процессора игре" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkHighPriorityCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#182333" Margin="0,6"/>

                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="План питания «Максимальная производительность»" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Активирует скрытый режим Ultimate Performance в Windows" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkPowerPlanCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <TextBlock Text="🖱️ МЫШЬ, ИГРА И СТАБИЛЬНОСТЬ" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,10"/>
                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Честный отклик мыши 1:1 (Кривые SmoothMouse)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Идеальные кривые 1:1, отключение акселерации Windows" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkMouseCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#182333" Margin="0,6"/>

                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Отключение Windows Game DVR" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Убирает фоновую фоновую запись клипов и оверлейные лаги" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkGameDvrCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="1" Background="#182333" Margin="0,6"/>

                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="Глубокая оптимизация Engine.ini" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Отключает туман, размытие и оптимизирует кэширование текстур" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TwkEngineIniCheck" Style="{StaticResource CyberSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================== -->
                <!-- 8. ВКЛАДКА: ИГРОВЫЕ ПРЕСЕТЫ (PRESETS) -->
                <!-- ========================================================== -->
                <ScrollViewer x:Name="ViewPresets" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📁 МЕНЕДЖЕР КИБЕРСПОРТИВНЫХ ПРЕСЕТОВ" FontSize="18" FontWeight="Black" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource CyberCard}" Margin="0,0,8,10">
                                <StackPanel>
                                    <TextBlock Text="⚡ Pro Tournament (Mongraal)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="FilterKeys 150ms • Nagle Off • 0.5ms Timer • High Priority" FontSize="11" Foreground="#64748B" Margin="0,4,0,12"/>
                                    <Button Content="Активировать пресет" Style="{StaticResource CyberButtonPrimary}" Height="36" Click="PresetMongraal_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CyberCard}" Margin="8,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="⚡ Maximum FPS (Endgame)" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="Stretched 1440x1080 • CPU Unpark • Engine.ini • GameDVR Off" FontSize="11" Foreground="#64748B" Margin="0,4,0,12"/>
                                    <Button Content="Активировать пресет" Style="{StaticResource CyberButtonPrimary}" Height="36" Click="PresetEndgame_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CyberCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="⚡ Balanced (Streaming)" FontSize="14" FontWeight="Bold" Foreground="#A78BFA"/>
                                    <TextBlock Text="Native 1920x1080 • Stable Timers • Google DNS" FontSize="11" Foreground="#64748B" Margin="0,4,0,12"/>
                                    <Button Content="Активировать пресет" Style="{StaticResource CyberButtonPrimary}" Height="36" Click="PresetBalanced_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CyberCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="⚡ Default Safe" FontSize="14" FontWeight="Bold" Foreground="#FBBF24"/>
                                    <TextBlock Text="Стандартные параметры системы с базовым ускорением" FontSize="11" Foreground="#64748B" Margin="0,4,0,12"/>
                                    <Button Content="Активировать пресет" Style="{StaticResource CyberButtonPrimary}" Height="36" Click="PresetSafe_Click"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================== -->
                <!-- 9. ВКЛАДКА: РАДАР ЗАДЕРЖКИ (PING RADAR) -->
                <!-- ========================================================== -->
                <ScrollViewer x:Name="ViewPing" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="📶 ЖИВОЙ РАДАР ПИНГА СЕРВЕРОВ (AWS &amp; VALVE)" FontSize="18" FontWeight="Black" Foreground="#F8FAFC"/>
                                <TextBlock Text="Многопоточный опрос турнирных и игровых кластеров." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="PingScanBtn" Content="⚡ ПРОВЕРИТЬ ВСЕ РЕГИОНЫ" Style="{StaticResource CyberButtonPrimary}" HorizontalAlignment="Right" Height="38" Click="RunPingScan_Click"/>
                        </Grid>

                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <Grid Margin="0,8">
                                    <StackPanel Width="240" HorizontalAlignment="Left">
                                        <TextBlock Text="Европа (Франкфурт)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Главный турнирный кластер EU" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PingBarEu" Height="10" Margin="250,0,100,0" VerticalAlignment="Center" Background="#182234" Foreground="#10B981" Value="0"/>
                                    <TextBlock x:Name="PingTextEu" Text="-- мс" FontSize="13" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#182333"/>

                                <Grid Margin="0,8">
                                    <StackPanel Width="240" HorizontalAlignment="Left">
                                        <TextBlock Text="Google DNS (8.8.8.8)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Игровой шлюз Anycast" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PingBarGoogle" Height="10" Margin="250,0,100,0" VerticalAlignment="Center" Background="#182234" Foreground="#10B981" Value="0"/>
                                    <TextBlock x:Name="PingTextGoogle" Text="-- мс" FontSize="13" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#182333"/>

                                <Grid Margin="0,8">
                                    <StackPanel Width="240" HorizontalAlignment="Left">
                                        <TextBlock Text="Cloudflare DNS (1.1.1.1)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Быстрый резервный DNS" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PingBarCf" Height="10" Margin="250,0,100,0" VerticalAlignment="Center" Background="#182234" Foreground="#10B981" Value="0"/>
                                    <TextBlock x:Name="PingTextCf" Text="-- мс" FontSize="13" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#182333"/>

                                <Grid Margin="0,8">
                                    <StackPanel Width="240" HorizontalAlignment="Left">
                                        <TextBlock Text="Восток США (Вирджиния)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Кластер NA-East" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PingBarNaEast" Height="10" Margin="250,0,100,0" VerticalAlignment="Center" Background="#182234" Foreground="#F59E0B" Value="0"/>
                                    <TextBlock x:Name="PingTextNaEast" Text="-- мс" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#182333"/>

                                <Grid Margin="0,8">
                                    <StackPanel Width="240" HorizontalAlignment="Left">
                                        <TextBlock Text="Запад США (Орегон)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Кластер NA-West" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="PingBarNaWest" Height="10" Margin="250,0,100,0" VerticalAlignment="Center" Background="#182234" Foreground="#EF4444" Value="0"/>
                                    <TextBlock x:Name="PingTextNaWest" Text="-- мс" FontSize="13" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================== -->
                <!-- 10. ВКЛАДКА: ОЧИСТКА КЭША (CLEANUP) -->
                <!-- ========================================================== -->
                <ScrollViewer x:Name="ViewCleanup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🧹 ОЧИСТКА КЭША ШЕЙДЕРОВ И ВРЕМЕННЫХ ФАЙЛОВ" FontSize="18" FontWeight="Black" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                        <Border Style="{StaticResource CyberCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Глубокая очистка игрового мусора и повреждённых шейдеров" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <TextBlock Text="Безопасно удаляет устаревший кэш DirectX / NVIDIA GLCache / AMD DxCache, накопившиеся crash-логи и временные файлы для устранения микрофризов." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🧹 ОЧИСТИТЬ КЭШ ШЕЙДЕРОВ" Style="{StaticResource CyberButtonPrimary}" Height="40" Margin="0,0,12,0" Click="CleanShaders_Click"/>
                                    <TextBlock x:Name="CleanShadersStatus" Text="Готов к очистке" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <TextBlock Text="⚡ Мгновенный сброс оперативной памяти (RAM Flush)" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,8"/>
                                <TextBlock Text="Принудительная сборка мусора и очистка рабочих наборов (Working Set Trim) для всех фоновых процессов. Высвобождает сотни мегабайт ОЗУ." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⚡ СБРОС ОПЕРАТИВНОЙ ПАМЯТИ" Style="{StaticResource CyberButtonPrimary}" Height="40" Margin="0,0,12,0" Click="FlushRamAction_Click"/>
                                    <TextBlock x:Name="FlushRamStatus" Text="Готов к сбросу памяти" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================================================== -->
                <!-- 11. ВКЛАДКА: ОТКАТ ПАРАМЕТРОВ (RESTORE) -->
                <!-- ========================================================== -->
                <ScrollViewer x:Name="ViewRestore" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource CyberCard}">
                            <StackPanel>
                                <TextBlock Text="🛡️ ВОССТАНОВЛЕНИЕ ЗАВОДСКИХ НАСТРОЕК WINDOWS" FontSize="17" FontWeight="Black" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                                <TextBlock Text="В один клик верните любые параметры системы в исходное состояние Microsoft:&#x0a;• Схема питания Windows возвращается в «Сбалансированная»&#x0a;• Сетевой стек TCP/IP и алгоритм Nagle сбрасываются к стандартам&#x0a;• DNS возвращается в автоматический режим (DHCP провайдера)&#x0a;• Клавиатура и таймеры возвращаются к стандартным задержкам Windows&#x0a;• Стандартные кривые мыши и службы GameDVR восстанавливаются" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                <Button Content="ВЕРНУТЬ ВСЕ НАСТРОЙКИ WINDOWS ПО УМОЛЧАНИЮ" Style="{StaticResource CyberButtonDanger}" Height="44" HorizontalAlignment="Left" Click="RestoreWindowsDefaults_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- МОДАЛЬНОЕ ОКНО ПЕРЕИМЕНОВАНИЯ ИГРЫ -->
        <Grid x:Name="RenameModal" Visibility="Collapsed" Grid.ColumnSpan="2" Background="#D8050810">
            <Border Width="440" Background="#0C1322" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="✏️ Переименовать игру" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Введите новое название игры для отображения в VORTEX:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,12"/>
                    <TextBox x:Name="RenameTextBox" Style="{StaticResource CyberTextBox}" Height="38" FontSize="13" Margin="0,0,0,18" KeyDown="RenameTextBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Click="RenameCancel_Click" Style="{StaticResource CyberButtonSecondary}" Margin="0,0,8,0" Width="90"/>
                        <Button Content="Сохранить" Click="RenameSave_Click" Style="{StaticResource CyberButtonPrimary}" Width="110"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- МОДАЛЬНОЕ КИБЕР-ОКНО УВЕДОМЛЕНИЙ VORTEX (ВМЕСТО БЕЛЫХ ОКОН WINDOWS) -->
        <Grid x:Name="CyberAlertModal" Visibility="Collapsed" Grid.ColumnSpan="2" Background="#D8050810">
            <Border Width="480" Background="#0C1322" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="AlertModalTitle" Text="VORTEX" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AlertModalMessage" Text="Сообщение" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20"/>
                    <Button Content="ПОНЯТНО" Click="AlertModalOk_Click" Style="{StaticResource CyberButtonPrimary}" HorizontalAlignment="Right" Width="120" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
