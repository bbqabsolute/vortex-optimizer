<Window x:Class="VortexNet8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VORTEX — Мультиигровой Оптимизатор и Лаунчер (C# .NET 8 Pro)"
        Icon="pack://application:,,,/assets/icons/vortex_logo.ico"
        Height="880" Width="1300"
        MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080C14"
        Foreground="#F8FAFC"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Стили кнопок -->
        <Style x:Key="CyberButtonPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberButtonSecondary" TargetType="Button">
            <Setter Property="Background" Value="#141D2C"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1E2E48"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2B40"/>
                    <Setter Property="Foreground" Value="#93C5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberButtonSuccess" TargetType="Button">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CyberButtonDanger" TargetType="Button">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#FEE2E2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка навигации сайдбара -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#162033"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Круглая кнопка по центру дашборда -->
        <Style x:Key="RoundCircleBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0C1524" Offset="0.0"/>
                        <GradientStop Color="#14233D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль карточки -->
        <Style x:Key="CyberCard" TargetType="Border">
            <Setter Property="Background" Value="#101724"/>
            <Setter Property="BorderBrush" Value="#1C273A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Стиль текстового поля -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D131F"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1C273A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль тумблера CheckBox -->
        <Style x:Key="CyberSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack" Width="44" Height="22" CornerRadius="11" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,12,0">
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="#94A3B8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Глубокий темный стиль скроллбаров (без элементов Windows) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#1E293B" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном в кибер-стиле -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowBorder" Background="#080C14" BorderBrush="#1C273A" BorderThickness="1">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- БОКОВОЕ МЕНЮ (САЙДБАР) БЕЗ ФОНОВОГО СТРАЖА -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#0A0E17" BorderBrush="#1A2333" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Брендинг VORTEX -->
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/assets/icons/vortex_logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VORTEX" FontSize="20" FontWeight="Black" Foreground="#F8FAFC"/>
                            <TextBlock Text="PERFORMANCE ENGINE" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#1A2333" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Нижняя кнопка закрытия приложения (БЕЗ Фонового стража) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,14">
                    <Button Content="✕ Закрыть VORTEX" Style="{StaticResource CyberButtonDanger}" HorizontalAlignment="Stretch" Height="38" Click="ExitApp_Click"/>
                </StackPanel>

                <!-- 11 навигационных вкладок -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,2,8,2">
                    <StackPanel>
                        <TextBlock Text="НАВИГАЦИЯ" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="14,4,14,6"/>

                        <!-- 1. Главный экран -->
                        <Button x:Name="NavDashboardBtn" Style="{StaticResource SidebarNavBtn}" Background="#162033" Foreground="#60A5FA" Margin="0,1" Click="Nav_Click" Tag="dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_dashboard.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Главный экран" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. Серверы игр (Пинг) -->
                        <Button x:Name="NavServicesBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="services">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_services.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Серверы игр (Пинг)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. Настройки и параметры -->
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_tweaks.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Настройки и параметры" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. Разрешение в игре -->
                        <Button x:Name="NavResolutionBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="resolution">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_resolution.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Разрешение в игре" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. Сеть и DNS -->
                        <Button x:Name="NavNetworkBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="network">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_network.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Сеть и DNS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 6. Инпут-лаг & FilterKeys -->
                        <Button x:Name="NavLatencyBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="latency">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_latency.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Инпут-лаг &amp; FilterKeys" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 7. Твики Windows & FPS -->
                        <Button x:Name="NavTweaksBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="tweaks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_tweaks.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Твики Windows &amp; FPS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 8. Игровые пресеты -->
                        <Button x:Name="NavPresetsBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="presets">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_presets.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Игровые пресеты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 9. Радар пинга -->
                        <Button x:Name="NavPingBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="ping">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_ping.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Радар пинга" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 10. Очистка кэша -->
                        <Button x:Name="NavCleanupBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="cleanup">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_cleanup.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Очистка кэша" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 11. Откат параметров -->
                        <Button x:Name="NavRestoreBtn" Style="{StaticResource SidebarNavBtn}" Margin="0,1" Click="Nav_Click" Tag="restore">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/assets/icons/nav_restore.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <TextBlock Text="Откат параметров" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ОСНОВНАЯ ОБЛАСТЬ (ВЕРХНЯЯ ПАНЕЛЬ ТЕЛЕМЕТРИИ + 11 ВКЛАДОК) -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА ТЕЛЕМЕТРИИ И УПРАВЛЕНИЯ ОКНОМ (БЕЗ ЭЛЕМЕНТОВ WINDOWS) -->
            <Border Grid.Row="0" Background="#0A0E17" BorderBrush="#1A2333" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="18,0">
                    <!-- Левая сторона: Телеметрия RAM, ЯДРО, Статус игры -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#101724" BorderBrush="#1C273A" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠 RAM: " FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                                <TextBlock x:Name="HeaderRamText" Text="Загрузка..." FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,12,0"/>
                                <TextBlock Text="⏱️ ЯДРО: " FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="HeaderTimerText" Text="0.500 мс" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="HeaderGameStatusBorder" Background="#121D2C" BorderBrush="#1E2F48" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <TextBlock x:Name="HeaderGameStatusText" Text="● Fortnite (Готова к запуску)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Правая сторона: Кнопки управления окном VORTEX (минимизация, разворот, закрытие) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Click="BtnMinimize_Click" Style="{StaticResource WindowControlBtn}" ToolTip="Свернуть"/>
                        <Button Content="⬜" Click="BtnMaximize_Click" Style="{StaticResource WindowControlBtn}" ToolTip="Развернуть / Восстановить"/>
                        <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource WindowCloseBtn}" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- КОНТЕЙНЕР ДЛЯ ВСЕХ 11 ВКЛАДОК -->
            <Grid Grid.Row="1">
                
                <!-- ========================================================== -->
                <!-- 1. ВКЛАДКА: ГЛАВНЫЙ ЭКРАН (ПОЛНОЭКРАННАЯ ПАНЕЛЬ С ФОНОМ FORTNITE) -->
                <!-- ========================================================== -->
                <Grid x:Name="ViewDashboard" Visibility="Visible" Margin="14">
                    <!-- Фон с пользовательской картинкой геймплея Fortnite и кибер-затемнением -->
                    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#1E2E48" BorderThickness="1">
                        <Grid>
                            <!-- Картинка геймплея Fortnite / выбранной игры (динамическая) -->
                            <Image x:Name="DashboardBackgroundImage" Visibility="Collapsed" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            
                            <!-- Темный кибер-градиент и виньетка (обеспечивает читаемость и видимость карты 76%) -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#CC070B14" Offset="0.0"/>
                                        <GradientStop Color="#F0070B14" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Основное содержимое панели Дашборда -->
                            <Grid Margin="24,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ВЕРХ: Заголовок и пояснение -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock x:Name="HeroTitle" Text="Оптимизация и запуск Fortnite" FontSize="26" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="HeroSubtitle" Text="Выберите игру слева и нажмите «ЗАПУСК»: система оптимизируется, и игра откроется автоматически" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                </StackPanel>

